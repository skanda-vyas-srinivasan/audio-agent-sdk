{
  "name": "@sonexis/runtime",
  "version": "0.6.0",
  "description": "Typed Node.js client for the local Sonexis audio Runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "engines": { "node": ">=18" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.5.0" },
  "license": "GPL-2.0-or-later"
}
